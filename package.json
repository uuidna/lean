{
  "name": "@uuidna/lean",
  "version": "0.3.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Lean publishing worker at https://lean.uuidna.com \u2014 theorems and axioms occupying @uuidna/qpu.",
  "type": "module",
  "license": "CC-BY-NC-ND-4.0",
  "funding": {
    "type": "individual",
    "url": "https://revolut.me/ceccec"
  },
  "author": {
    "name": "Tsvetan Rouschev",
    "email": "ceccec@psg.bg",
    "url": "https://revolut.me/ceccec"
  },
  "homepage": "https://lean.uuidna.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uuidna/lean.git"
  },
  "bugs": {
    "url": "https://github.com/uuidna/lean/issues"
  },
  "keywords": [
    "lean",
    "theorems",
    "axioms",
    "uuidna",
    "qpu",
    "cloudflare-workers"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hologram": {
      "types": "./dist/hologram.d.ts",
      "import": "./dist/hologram.js"
    },
    "./theorems": {
      "types": "./dist/theorems.d.ts",
      "import": "./dist/theorems.js"
    },
    "./axioms": {
      "types": "./dist/axioms.d.ts",
      "import": "./dist/axioms.js"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "import": "./dist/metrics.js"
    },
    "./fractal": {
      "types": "./dist/fractal.d.ts",
      "import": "./dist/fractal.js"
    },
    "./scale": {
      "types": "./dist/scale.d.ts",
      "import": "./dist/scale.js"
    },
    "./og": {
      "types": "./dist/og.d.ts",
      "import": "./dist/og.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    },
    "./boot": {
      "types": "./dist/boot.d.ts",
      "import": "./dist/boot.js"
    }
  },
  "files": [
    "dist",
    "worker.js",
    "wrangler.toml",
    "README.md",
    "MANUAL.md",
    "LICENSE",
    "CITATION.cff",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/gen-readme.js",
    "!dist/gen-readme.d.ts"
  ],
  "sideEffects": [
    "./src/licence.ts",
    "./dist/licence.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node ./node_modules/@uuidna/qpu/dist/fasten-run.js dist/*.test.js",
    "ci": "npm test && npm run docs:build",
    "readme": "npm run build && node dist/gen-readme.js",
    "docs": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "ship": "npm run build && npm run docs:build && npx wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "typescript": "7.0.2",
    "vitepress": "2.0.0-alpha.20",
    "wrangler": "4.130.0"
  },
  "dependencies": {
    "@uuidna/qpu": "file:../qpu"
  }
}
